# Local doc fixtures — source MD files for review sessions, never published
fixtures/

# Generated doc inventory (output of Session 9, used to pull fixtures)
docs/doc-inventory.md

# Claude Code session files — not part of the public plugin
CLAUDE.md
.claude/

# Internal planning docs — kept local, not shipped with the plugin
docs/TECHNICAL_PLAN.md
docs/SESSIONS.md
docs/troubleshooting-gateway.md
docs/sessions/
docs/BACKLOG.md

# Pipeline test artifacts — generated during local development, not for release
scripts/test_output/

# Batch runner work files — temporary, created by run_batch.py --prepare
scripts/.batch_work/

# Manual/seed pipeline run logs — local audit trail only. Contain absolute
# local filesystem paths from the tee; never publish. The cron emits the
# .jsonl metrics (committed), not these .log files.
docs/metrics/*.log

# Raw GH Action run logs pulled locally for diagnosis — never publish.
run_logs.txt

